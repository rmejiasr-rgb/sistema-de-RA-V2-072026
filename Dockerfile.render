# Imagen para publicar en Render (u otro PaaS) como UN SOLO servicio:
# compila la aplicación visual (React/Vite) y la sirve junto al backend
# (Django + gunicorn + WhiteNoise) en la misma dirección. Sin nginx, sin CORS.
#
# Se construye desde la RAÍZ del repositorio:
#   docker build -f Dockerfile.render -t sistema-ra .

# ---- Etapa 1: compilar la aplicación visual -------------------------------
FROM node:22-alpine AS frontend
WORKDIR /fe
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
# La API vive en el mismo dominio, en la ruta /api (sin CORS).
ENV VITE_API_URL=/api
ENV VITE_SSO_ENABLED=false
RUN npm run build          # resultado en /fe/dist

# ---- Etapa 2: backend + servido de todo -----------------------------------
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# libpq para psycopg2; el resto son dependencias de WeasyPrint (PDF).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libgdk-pixbuf-2.0-0 \
    libffi-dev shared-mime-info fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# La app visual ya compilada se copia a /app/spa; WhiteNoise la sirve en la raíz.
COPY --from=frontend /fe/dist ./spa

# Recolecta los estáticos de Django (admin, DRF). No requiere base de datos.
RUN mkdir -p /app/media /app/staticfiles && python manage.py collectstatic --noinput

EXPOSE 8000

# Al arrancar: migra la base, prepara usuario + datos de ejemplo (idempotente,
# no detiene el arranque si la carga de ejemplo falla) y levanta gunicorn.
# Render entrega el puerto en la variable $PORT.
CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py bootstrap_demo && gunicorn config.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 3 --timeout 120"]
