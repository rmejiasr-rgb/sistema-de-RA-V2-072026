# Variables de producción para docker-compose.prod.yml.
# Copiar a .env y completar. NO subir .env al repositorio.

# Django
DJANGO_SECRET_KEY=genere-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=ra.unimet.edu.ve
CSRF_TRUSTED_ORIGINS=https://ra.unimet.edu.ve
CORS_ALLOWED_ORIGINS=https://ra.unimet.edu.ve
SECURE_SSL_REDIRECT=True

# PostgreSQL
POSTGRES_DB=sistema_ra
POSTGRES_USER=sistema_ra
POSTGRES_PASSWORD=cambie-esta-clave

# Umbrales de semáforo (opcional)
SEMAFORO_UMBRAL_VERDE=70
SEMAFORO_UMBRAL_AMARILLO=50

# SSO Microsoft Entra ID (opcional, ver docs/SSO_ENTRA.md)
SSO_ENABLED=False
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=organizations

# Backups
BACKUP_DIR=./backups
BACKUP_RETENCION_DIAS=30
